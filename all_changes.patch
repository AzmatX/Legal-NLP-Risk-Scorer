+        
+        result = ingest_document(str(file_path))
+        
+        assert result['processed'] is True
+        assert result['content']['text'] == content
+    
+    def test_ingest_pdf_marks_for_ocr(self, tmp_path):
+        """Test that PDF files are marked for OCR processing."""
